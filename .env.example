DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pw_os
# Para desenvolvimento local: docker compose up -d postgres
PW_OS_MASTER_EMAIL=
PW_OS_MASTER_INITIAL_PASSWORD=
SESSION_SECRET=
FILE_STORAGE_DRIVER=local
FILE_STORAGE_LOCAL_PATH=./data/files
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=pw-os-9ddce
FIREBASE_STORAGE_BUCKET=pw-os-9ddce.firebasestorage.app
# No Azure/local, forneça uma destas opções somente no backend:
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/seguro/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
INTEGRATION_ENCRYPTION_KEY=
# URL pública sem barra final, usada nos links enviados por e-mail.
APP_BASE_URL=http://127.0.0.1:5173
# Azure Communication Services Email (SMTP). Deixe vazio no ambiente local para manter o Gmail atual.
AZURE_EMAIL_SMTP_HOST=smtp.azurecomm.net
AZURE_EMAIL_SMTP_USERNAME=
AZURE_EMAIL_SMTP_PASSWORD=
AZURE_EMAIL_FROM=
AZURE_EMAIL_FROM_NAME=PW OS
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_REDIRECT_URI=http://127.0.0.1:5173/api/integrations/google_ads/oauth/callback
# O mesmo cliente OAuth pode habilitar "Entrar com Google" para envio de e-mail.
# Adicione também esta URI autorizada no Google Cloud:
# http://127.0.0.1:5173/api/email/google/callback
META_ADS_APP_ID=
META_ADS_APP_SECRET=
META_ADS_ACCESS_TOKEN=
META_ADS_GRAPH_VERSION=v23.0
META_ADS_REDIRECT_URI=http://127.0.0.1:5173/api/integrations/meta_ads/oauth/callback
# Chave exclusiva do backend. Nunca use VITE_OPENAI_API_KEY nem exponha no navegador.
OPENAI_API_KEY=
OPENAI_INSIGHTS_MODEL=gpt-5.5
